# 前端用：Cloud Functions proxy URL（Gemini 金鑰在 proxy 後端，不會進前端 bundle）
# 本機開發預設打 local proxy；production 填 Cloud Function 部署後的 URL
VITE_GEMINI_PROXY_URL=http://localhost:8080

# 僅本機 proxy 開發時使用（functions/gemini-proxy 讀取）
# production 金鑰改放 GCP Secret Manager，不寫死在此
GEMINI_API_KEY=your_new_gemini_api_key_here
