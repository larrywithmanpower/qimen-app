{
  "name": "qimen-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm test && VITE_GEMINI_PROXY_URL=https://asia-east1-qimen-app-487007.cloudfunctions.net/gemini-proxy npm run build && npx firebase-tools deploy --only hosting --project qimen-app-487007",
    "test:unit": "vitest run",
    "test:ui": "playwright test -c playwright.mingli.config.ts",
    "test:mutation": "node tests/mutation.mjs",
    "test": "npm run test:unit && npm run test:ui",
    "dev:mingli": "vite --port 5180 --strictPort"
  },
  "dependencies": {
    "idb-keyval": "^6.2.2",
    "iztro": "^2.6.3",
    "lunar-javascript": "^1.6.43",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite-plugin-sitemap": "^0.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.7"
  }
