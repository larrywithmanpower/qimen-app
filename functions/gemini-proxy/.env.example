# 金鑰正式環境由 Secret Manager 掛成環境變數，不要寫進程式或 commit
ANTHROPIC_API_KEY=
# 緊急開關：不是 true 就回 503
AI_ENABLED=true
# 維護模式：true 時狀態端點（GET）回 maintenance:true，前端顯示維護頁；沒設等於 false
MAINTENANCE=false
# 每位登入會員每日（台灣日期）解讀次數上限
USER_DAILY_LIMIT=5
# 未登入者每日共用次數上限（全站一個計數）
ANON_DAILY_LIMIT=10
# 每日 AI 預算（台幣），用 ai_cost_daily 的 totalUsd x USD_TWD 比對，達標就全站停
DAILY_BUDGET_TWD=10
# 美金換台幣匯率（只用來比對預算）
USD_TWD=32.5
# 逗號分隔，沒帶 Origin 或不在名單一律 403
ALLOWED_ORIGINS=https://mingli-yuxuan.web.app,http://localhost:5180
