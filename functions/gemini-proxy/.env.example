# 金鑰正式環境由 Secret Manager 掛成環境變數，不要寫進程式或 commit
ANTHROPIC_API_KEY=
# 緊急開關：不是 true 就回 503
AI_ENABLED=true
# 維護模式：true 時狀態端點（GET）回 maintenance:true，前端顯示維護頁；沒設等於 false
MAINTENANCE=false
# 每日（台灣日期）解讀次數上限
DAILY_LIMIT=200
# 逗號分隔，沒帶 Origin 或不在名單一律 403
ALLOWED_ORIGINS=https://mingli-yuxuan.web.app,http://localhost:5180
